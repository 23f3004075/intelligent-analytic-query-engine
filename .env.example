# ==============================================================================
# IAQE Environment Configuration Example
# ==============================================================================
# Rename this file to .env and add your valid OpenRouter or OpenAI API key.
# Never commit your actual .env file with private keys to GitHub!

# OpenRouter API Key (Required for live LLM execution)
OPEN_ROUTER_KEY=your_openrouter_api_key_here

# Alternative standard OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Default LLM Model on OpenRouter
DEFAULT_MODEL=inclusionai/ling-3.0-flash-vl:free

# Web Dashboard Port (Default: 8000)
PORT=8000
